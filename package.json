{
  "name": "ngmaze",
  "version": "0.1.0",
  "description": "Angular component relationship static analyzer CLI",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ngmaze": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "docs/ngmaze.schema.json",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract",
    "test:integration": "vitest run tests/integration",
    "test:cli": "vitest run tests/cli",
    "test:e2e": "vitest run tests/e2e",
    "audit:angular-features": "node scripts/audit-angular-features.mjs"
  },
  "dependencies": {
    "@angular/compiler": "22.1.5",
    "commander": "^14.0.2",
    "picocolors": "^1.1.1",
    "typescript": "~6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "ajv": "^8.17.1",
    "vitest": "^3.2.4"
  }
}
